    "station": {
      "license": "CC0-1.0",
      "source": "jian-synth",
      "format": "wav",
      "dir": "",
      "events": {
        "weak": "weak.wav",
        "mid": "mid.wav",
        "strong": "strong.wav"
      }
    },
    "ui": {
      "license": "CC0-1.0",
      "source": "jian-synth",
      "format": "wav",
      "dir": "",
      "events": {
        "connect_ok": "connect_ok.wav",
        "connect_fail": "connect_fail.wav",
        "notify": "notify.wav"
      }
    }
