      "dir": "",
      "events": {
        "issue": "issue.mp3",
        "caution": "caution.mp3",
        "warn": "warn.mp3",
        "update": "update.mp3",
        "final": "final.mp3",
        "cancel": "cancel.mp3",
        "prompt": "prompt.mp3",
        "hypocenter": "hypocenter.mp3",
        "detail": "detail.mp3",
        "shindo_0": "shindo0.mp3",
        "shindo_1": "shindo1.mp3",
        "shindo_2": "shindo2.mp3",
        "shindo_3": "shindo3.mp3",
        "shindo_4": "shindo4.mp3",
        "shindo_5": "shindo5.mp3",
        "shindo_6": "shindo6.mp3",
        "shindo_7": "shindo7.mp3",
        "tsunami1_issue": "tsunami1issue.mp3",
        "tsunami1_update": "tsunami1update.mp3",
        "tsunami1_switch": "tsunami1switch.mp3",
        "tsunami1_cancel": "tsunami1cancel.mp3",
        "tsunami2_issue": "tsunami2issue.mp3",
        "tsunami2_update": "tsunami2update.mp3",
        "tsunami2_switch": "tsunami2switch.mp3",
        "tsunami2_cancel": "tsunami2cancel.mp3",
        "tsunami3_issue": "tsunami3issue.mp3",
        "tsunami3_update": "tsunami3update.mp3",
        "tsunami3_cancel": "tsunami3cancel.mp3"
      }
    },
    "eewcn": {
      "license": "see media/ATTRIBUTION.md",
      "source": "Open EEW CN",
      "use_for": ["default_eew", "cea", "cenc", "cwa", "record", "other_non_jma", "s_arrive"],
      "format": "wav",
      "dir": "",
      "events": {
        "issue": "eewalert.wav",
        "update": "eewupdate.wav",
        "final": "eewupdate.wav",
        "critical": "eewcritical.wav",
        "record": "newrecord.wav",
        "arrive_s": "swavearrive.wav"
      }
    },
    "countdown": {
      "license": "see media/ATTRIBUTION.md",
      "source": "地牛Wake Up!",
      "use_for": ["local_s_countdown"],
      "format": "mp3/wav",
      "dir": "",
      "events": {
        "countdown_loop": "countdown.wav",
        "0s": "0s.mp3",
        "1s": "1s.mp3",
        "2s": "2s.mp3",
        "3s": "3s.mp3",
        "4s": "4s.mp3",
        "5s": "5s.mp3",
        "6s": "6s.mp3",
        "7s": "7s.mp3",
        "8s": "8s.mp3",
        "9s": "9s.mp3",
        "10s": "10s.mp3",
        "20s": "20s.mp3",
        "30s": "30s.mp3",
        "40s": "40s.mp3",
        "50s": "50s.mp3",
        "60s": "60s.mp3"
      }
    },
    "eew": {
      "license": "CC0-1.0",
      "source": "jian-synth",
      "use_for": ["fallback"],
      "format": "wav",
      "dir": "",
      "events": {
        "issue": "issue.wav",
        "update": "update.wav",
        "final": "final.wav",
        "cancel": "cancel.wav",
        "prompt": "prompt.wav",
        "arrive_p": "arrive_p.wav",
        "arrive_s": "arrive_s.wav"
      }
